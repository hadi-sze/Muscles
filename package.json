{
  "name": "musclewiki-react-recreation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --mode https --host 127.0.0.1",
    "build": "vite build --mode https && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "setup:https": "node scripts/setup-https.mjs",
    "dev:https": "npm run setup:https && vite --mode https --host 127.0.0.1 --port 5176 --strictPort",
    "preview:https": "npm run setup:https && vite preview --mode https --host 127.0.0.1 --port 5170 --strictPort"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@mui/stylis-plugin-rtl": "^9.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stylis": "^4.4.0"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
